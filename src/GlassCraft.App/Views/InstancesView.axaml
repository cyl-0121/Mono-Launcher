<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GlassCraft.App.Controls"
             x:Class="GlassCraft.App.Views.InstancesView">
  <Grid ColumnDefinitions="400,*" ColumnSpacing="14">
    <controls:GlassCard Grid.Column="0" CornerRadius="18" TintOpacity="0.28" Padding="16">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
        <StackPanel Grid.Row="0" Spacing="2">
          <TextBlock Text="实例" Classes="h2" />
          <TextBlock Text="每个实例拥有独立游戏目录，互不干扰。" Classes="muted" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBox Classes="field" Watermark="实例名称（可留空）" Text="{Binding NewName}" />
            <ComboBox Classes="field" ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding NewVersion}"
                      PlaceholderText="选择已安装版本" />
          </StackPanel>
          <Button Grid.Column="1" Classes="primary" Content="新建" VerticalAlignment="Center"
                  Command="{Binding CreateCommand}" />
        </Grid>

        <ListBox Grid.Row="2" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="10" Padding="10" Background="#F8FAFD" Margin="0,2">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Border Width="38" Height="38" CornerRadius="10" Background="#2E4F8BFF">
                    <TextBlock Text="▦" Foreground="#111111" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Name}" Foreground="#111111" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VersionText}" Classes="muted" />
                    <TextBlock Text="{Binding LastPlayedText}" Classes="muted" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Content="打开目录" Command="{Binding OpenFolderCommand}" />
          <Button Classes="ghost" Content="移入回收站" Command="{Binding DeleteCommand}" />
        </StackPanel>

        <Border Grid.Row="4" Background="#F8FAFD" CornerRadius="10" Padding="10">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="导入现有实例" Classes="muted" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghost" Content="扫描" Padding="10,5"
                      Command="{Binding ScanImportCommand}" />
            </Grid>
            <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                     Background="Transparent" BorderThickness="0" MaxHeight="96">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" Foreground="#111111" FontSize="12" />
                    <TextBlock Text="{Binding SourceText}" Classes="muted" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Classes="ghost" Content="导入所选（复制存档，不改源目录）"
                    Command="{Binding ImportCommand}" />
          </StackPanel>
        </Border>
      </Grid>
    </controls:GlassCard>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="14">
      <controls:GlassCard Grid.Row="0" CornerRadius="18" TintOpacity="0.30" Padding="18">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
            <TextBlock Text="{Binding SelectedInstance.Name, FallbackValue=未选择实例}" Classes="h1" FontSize="22" />
            <TextBlock Text="{Binding SelectedInstance.VersionText}" Classes="muted" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
            <Button Classes="primary" Content="启动" Command="{Binding LaunchCommand}" />
            <Button Classes="ghost" Content="结束进程" Command="{Binding KillCommand}" />
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding GameState}" Foreground="#888888"
                     FontSize="13" Margin="0,12,0,0" />
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ErrorText}" Foreground="#C62828"
                     FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
        </Grid>
      </controls:GlassCard>

      <controls:GlassCard Grid.Row="1" CornerRadius="18" TintOpacity="0.26" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="游戏日志" Classes="h2" />
            <Button Grid.Column="1" Classes="ghost" Content="读取日志" Command="{Binding ReadLogCommand}" />
            <Button Grid.Column="2" Classes="ghost" Content="日志目录" Command="{Binding OpenLogsFolderCommand}" Margin="8,0,0,0" />
          </Grid>
          <TextBox Grid.Row="1" Text="{Binding GameLog}" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                   Background="#0A000000" Foreground="#555555" CornerRadius="8" />
        </Grid>
      </controls:GlassCard>
    </Grid>
  </Grid>
</UserControl>
