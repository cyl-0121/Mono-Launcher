<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GlassCraft.App.Controls"
             x:Class="GlassCraft.App.Views.SettingsView">
  <ScrollViewer HorizontalContentAlignment="Stretch">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14" Margin="0,0,10,10">
      <controls:GlassCard Grid.Row="0" CornerRadius="18" TintOpacity="0.30" Padding="20">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="设置" Classes="h1" FontSize="22" />
            <TextBlock Text="配置文件与实例配置分离，保存后立即生效。" Classes="muted" />
          </StackPanel>
          <Button Grid.Column="1" Classes="primary" Content="保存设置" Command="{Binding SaveCommand}" />
        </Grid>
      </controls:GlassCard>

      <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14">
        <controls:GlassCard Grid.Column="0" CornerRadius="18" TintOpacity="0.26" Padding="20">
          <StackPanel Spacing="10">
            <TextBlock Text="Java 与内存" Classes="h2" />
            <TextBlock Text="Java 路径（留空自动检测）" Classes="muted" />
            <TextBox Classes="field" Text="{Binding JavaPath}" Watermark="C:\\Program Files\\Java\\jdk-21\\bin\\java.exe" />
            <Button Classes="ghost" Content="重新扫描 Java" Command="{Binding ScanJavaCommand}" HorizontalAlignment="Left" />
            <ListBox ItemsSource="{Binding JavaRuntimes}" Background="Transparent" MaxHeight="120">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding DisplayName}" Foreground="#FFFFFF" FontSize="12" />
                    <TextBlock Text="{Binding ExecutablePath}" Classes="muted" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="最小内存 (MB)" Classes="muted" />
                <NumericUpDown Value="{Binding MinMemoryMb}" Minimum="256" Maximum="32768" Increment="256" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="最大内存 (MB)" Classes="muted" />
                <NumericUpDown Value="{Binding MaxMemoryMb}" Minimum="512" Maximum="65536" Increment="512" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </controls:GlassCard>

        <controls:GlassCard Grid.Column="1" CornerRadius="18" TintOpacity="0.26" Padding="20">
          <StackPanel Spacing="10">
            <TextBlock Text="下载与网络" Classes="h2" />
            <TextBlock Text="并发连接数" Classes="muted" />
            <NumericUpDown Value="{Binding DownloadConcurrency}" Minimum="1" Maximum="32" Increment="1" />
            <TextBlock Text="代理（http://host:port，留空直连）" Classes="muted" />
            <TextBox Classes="field" Text="{Binding ProxyUrl}" />
            <CheckBox Content="启用 BMCLAPI 镜像作为备用源" IsChecked="{Binding UseMirror}" Foreground="#B0B0B0" />
            <TextBlock Text="可视化与动画" Classes="h2" Margin="0,8,0,0" />
            <CheckBox Content="启用过渡动画" IsChecked="{Binding AnimationsEnabled}" Foreground="#B0B0B0" />
            <CheckBox Content="启用指针光照" IsChecked="{Binding PointerLighting}" Foreground="#B0B0B0" />
            <CheckBox Content="帧率过低时自动降档" IsChecked="{Binding AutoDowngrade}" Foreground="#B0B0B0" />
            <TextBlock Text="AI 流式刷新间隔 (ms)" Classes="muted" />
            <NumericUpDown Value="{Binding AiStreamFlushMs}" Minimum="10" Maximum="500" Increment="10" />
          </StackPanel>
        </controls:GlassCard>
      </Grid>

      <controls:GlassCard Grid.Row="2" CornerRadius="18" TintOpacity="0.24" Padding="20">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="数据目录" Classes="h2" />
            <TextBlock Text="{Binding DataDirectory}" Classes="muted" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding StatusText}" Foreground="#8A8A8A" FontSize="12" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" Content="打开数据目录" Command="{Binding OpenDataFolderCommand}" />
        </Grid>
      </controls:GlassCard>

      <controls:GlassCard Grid.Row="3" CornerRadius="18" TintOpacity="0.24" Padding="20">
        <StackPanel Spacing="8">
          <TextBlock Text="更新与公告" Classes="h2" />
          <TextBlock Text="填写 GitHub 仓库（owner/repo），启动时会自动拉取最新 Release 显示在首页「Today」下方。"
                     Classes="muted" TextWrapping="Wrap" />
          <TextBox Classes="field" Text="{Binding UpdateRepository}" PlaceholderText="例如：yourname/GlassCraft" />
          <TextBlock Text="留空则不检查更新。更新检查只读取公开的 Release 信息，不上传任何数据。"
                     Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </controls:GlassCard>
    </Grid>
  </ScrollViewer>
</UserControl>
