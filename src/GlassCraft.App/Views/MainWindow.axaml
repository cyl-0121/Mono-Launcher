<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GlassCraft.App.Controls"
        xmlns:views="using:GlassCraft.App.Views"
        xmlns:vm="using:GlassCraft.App.ViewModels"
        x:Class="GlassCraft.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GlassCraft 启动器"
        Width="1160" Height="720" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#05070D"
        FontFamily="Inter, Microsoft YaHei UI, Segoe UI">
  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F2F6FF" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#E8EFFF" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8A97AD" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#C7D2E5" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22FFFFFF" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#2E4F8BFF" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#3D6BFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#4F7BFF" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#18FFFFFF" />
      <Setter Property="Foreground" Value="#DCE6F7" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2AFFFFFF" />
    </Style>
    <Style Selector="Border.msg">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="MaxWidth" Value="720" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderBrush" Value="#1AFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.msg.user">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="#2E4F8BFF" />
      <Setter Property="BorderBrush" Value="#505F8CFF" />
    </Style>
    <Style Selector="Border.msg.tool">
      <Setter Property="Background" Value="#12FFD479" />
      <Setter Property="BorderBrush" Value="#33FFD479" />
    </Style>
    <Style Selector="Border.msg.system">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="Foreground" Value="#E6EDF7" />
      <Setter Property="BorderBrush" Value="#22FFFFFF" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ComboBox.field">
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="Foreground" Value="#E6EDF7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>

  <Grid>
    <controls:AuroraBackground />

    <Grid ColumnDefinitions="238,*">
      <!-- Sidebar -->
      <controls:GlassCard Grid.Column="0" Margin="12,12,0,12" CornerRadius="20" TintOpacity="0.34">
        <DockPanel Margin="14,16">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,6,0,20">
            <Border Width="34" Height="34" CornerRadius="10" Background="#3D6BFF">
              <TextBlock Text="G" FontSize="19" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="GlassCraft" FontSize="16" FontWeight="SemiBold" Foreground="#F2F6FF" />
              <TextBlock Text="原生玻璃启动器" Classes="muted" />
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="4,10,4,4">
            <TextBlock Text="{Binding TierText}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="v0.9.0 · Avalonia 12 / .NET 10" Classes="muted" />
          </StackPanel>

          <StackPanel>
            <TextBlock Text="导航" Classes="muted" Margin="8,0,0,6" />
            <Button Classes="nav" Name="NavHome" Content="🏠  首页" Command="{Binding NavigateCommand}" CommandParameter="home" />
            <Button Classes="nav" Name="NavVersions" Content="⬇  游戏下载" Command="{Binding NavigateCommand}" CommandParameter="versions" />
            <Button Classes="nav" Name="NavInstances" Content="▦  实例管理" Command="{Binding NavigateCommand}" CommandParameter="instances" />
            <Button Classes="nav" Name="NavMods" Content="🧩  Mod 管理" Command="{Binding NavigateCommand}" CommandParameter="mods" />
            <Button Classes="nav" Name="NavDownloads" Content="⇩  下载管理" Command="{Binding NavigateCommand}" CommandParameter="downloads" />
            <Button Classes="nav" Name="NavLogs" Content="📄  日志" Command="{Binding NavigateCommand}" CommandParameter="logs" />
            <Button Classes="nav" Name="NavAgent" Content="✦  AI Agent" Command="{Binding NavigateCommand}" CommandParameter="agent" />
            <Button Classes="nav" Name="NavSettings" Content="⚙  设置" Command="{Binding NavigateCommand}" CommandParameter="settings" />
          </StackPanel>
        </DockPanel>
      </controls:GlassCard>

      <!-- Main -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Name="TitleBar" Height="54" Margin="20,8,20,0">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentPageTitle}" FontSize="14" Foreground="#DCE6F7" />
            <TextBlock Text="{Binding CurrentPageSubtitle}" FontSize="12" Foreground="#6E7F99" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Background="#14FFFFFF" CornerRadius="9" Padding="10,5">
              <TextBlock Text="{Binding FpsText}" FontSize="12" Foreground="#B9C7DD" />
            </Border>
            <Border Background="#10FFFFFF" CornerRadius="9" Padding="10,5">
              <TextBlock Text="{Binding ActiveProfileText}" FontSize="12" Foreground="#B9C7DD" />
            </Border>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,4,20,16">
          <ContentControl Content="{Binding CurrentViewModel}" HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vm:HomeViewModel">
                <views:HomeView />
              </DataTemplate>
              <DataTemplate DataType="vm:AgentViewModel">
                <views:AgentView />
              </DataTemplate>
              <DataTemplate DataType="vm:VersionsViewModel">
                <views:VersionsView />
              </DataTemplate>
              <DataTemplate DataType="vm:InstancesViewModel">
                <views:InstancesView />
              </DataTemplate>
              <DataTemplate DataType="vm:ModsViewModel">
                <views:ModsView />
              </DataTemplate>
              <DataTemplate DataType="vm:DownloadsViewModel">
                <views:DownloadsView />
              </DataTemplate>
              <DataTemplate DataType="vm:LogsViewModel">
                <views:LogsView />
              </DataTemplate>
              <DataTemplate DataType="vm:SettingsViewModel">
                <views:SettingsView />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
