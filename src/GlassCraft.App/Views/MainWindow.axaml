<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GlassCraft.App.Controls"
        xmlns:views="using:GlassCraft.App.Views"
        xmlns:vm="using:GlassCraft.App.ViewModels"
        x:Class="GlassCraft.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GlassCraft"
        Width="1120" Height="700" MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="#F7F7F7"
        FontFamily="avares://GlassCraft/Assets/Fonts#SF Pro Display, Microsoft YaHei UI, Segoe UI">
  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#111111" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#111111" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#888888" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Top navigation -->
    <Style Selector="Button.nav">
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1FFFFFFF" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Window chrome -->
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#D0D0D0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22FFFFFF" />
      <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C62828" />
      <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#111111" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2B2B2B" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#000000" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#111111" />
      <Setter Property="BorderBrush" Value="#CCCCCC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F2F8FF" />
      <Setter Property="BorderBrush" Value="#111111" />
    </Style>

    <!-- Chat -->
    <Style Selector="Border.msg">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="MaxWidth" Value="720" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="#F2F2F2" />
      <Setter Property="BorderBrush" Value="#E5E5E5" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.msg.user">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="#F2F2F2" />
      <Setter Property="BorderBrush" Value="#D5D5D5" />
    </Style>
    <Style Selector="Border.msg.tool">
      <Setter Property="Background" Value="#F5F5F5" />
      <Setter Property="BorderBrush" Value="#DDDDDD" />
    </Style>
    <Style Selector="Border.msg.system">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="#F7F7F7" />
      <Setter Property="Foreground" Value="#111111" />
      <Setter Property="BorderBrush" Value="#D5D5D5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="ComboBox.field">
      <Setter Property="Background" Value="#F7F7F7" />
      <Setter Property="Foreground" Value="#111111" />
      <Setter Property="BorderBrush" Value="#D5D5D5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#F2F2F2" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="48,*">
    <!-- Top bar: brand + navigation, PCL-style -->
    <Grid Grid.Row="0" Name="TitleBar" Background="#111111">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="18,0,0,0"
                    VerticalAlignment="Center">
          <TextBlock Text="GlassCraft" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" />
          <TextBlock Text="v0.9" FontSize="11" Foreground="#9A9A9A" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="0">
          <Button Classes="nav" Name="NavHome" Command="{Binding NavigateCommand}" CommandParameter="home">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="▶" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="启动" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavVersions" Command="{Binding NavigateCommand}" CommandParameter="versions">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="⬇" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="下载" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavInstances" Command="{Binding NavigateCommand}" CommandParameter="instances">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="▦" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="版本" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavMods" Command="{Binding NavigateCommand}" CommandParameter="mods">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="◈" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="Mod" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavNetwork" Command="{Binding NavigateCommand}" CommandParameter="network">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="◎" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="联机" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavLogs" Command="{Binding NavigateCommand}" CommandParameter="logs">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="▤" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="日志" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavAgent" Command="{Binding NavigateCommand}" CommandParameter="agent">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="✦" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="AI" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavSettings" Command="{Binding NavigateCommand}" CommandParameter="settings">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="⚙" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="设置" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Classes="chrome" Content="—" Click="OnMinimizeClick" />
          <Button Classes="chrome" Name="MaxButton" Content="□" Click="OnMaximizeClick" />
          <Button Classes="chrome close" Content="✕" Click="OnCloseClick" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Content -->
    <Grid Grid.Row="1" Background="#F7F7F7">
      <controls:AuroraBackground />
      <ContentControl Content="{Binding CurrentViewModel}" HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" Margin="16" Background="Transparent">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
          </DataTemplate>
          <DataTemplate DataType="vm:AgentViewModel">
            <views:AgentView />
          </DataTemplate>
          <DataTemplate DataType="vm:VersionsViewModel">
            <views:VersionsView />
          </DataTemplate>
          <DataTemplate DataType="vm:InstancesViewModel">
            <views:InstancesView />
          </DataTemplate>
          <DataTemplate DataType="vm:ModsViewModel">
            <views:ModsView />
          </DataTemplate>
          <DataTemplate DataType="vm:NetworkViewModel">
            <views:NetworkView />
          </DataTemplate>
          <DataTemplate DataType="vm:DownloadsViewModel">
            <views:DownloadsView />
          </DataTemplate>
          <DataTemplate DataType="vm:LogsViewModel">
            <views:LogsView />
          </DataTemplate>
          <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>
  </Grid>
</Window>
