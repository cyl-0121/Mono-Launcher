<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GlassCraft.App.Controls"
             xmlns:vm="using:GlassCraft.App.ViewModels"
             x:Class="GlassCraft.App.Views.ModsView">
  <Grid ColumnDefinitions="*,360" ColumnSpacing="14">
    <controls:GlassCard Grid.Column="0" CornerRadius="18" TintOpacity="0.28" Padding="16">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <ComboBox Grid.Column="0" Classes="field" ItemsSource="{Binding Instances}"
                    SelectedItem="{Binding SelectedInstance}" PlaceholderText="选择实例">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Text="{Binding VersionText}" FontSize="10" Foreground="#8A8A8A" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" Classes="ghost" Content="刷新" Command="{Binding RefreshAllCommand}" />
          <Button Grid.Column="2" Classes="ghost" Content="打开目录" Command="{Binding OpenModsFolderCommand}" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Classes="muted" />

        <ListBox Grid.Row="2" ItemsSource="{Binding Mods}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="10" Padding="10" Background="#111111" Margin="0,2">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="SemiBold" />
                      <Border Background="#111111" CornerRadius="5" Padding="5,1">
                        <TextBlock Text="{Binding Loader}" FontSize="10" Foreground="#8A8A8A" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding FileName}" Classes="muted" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Version}" Classes="muted" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="ghost" Content="启停" Padding="10,5"
                            Command="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).ToggleCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="ghost" Content="删除" Padding="10,5"
                            Command="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).DeleteCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Text="{Binding ErrorText}" Foreground="#C62828" FontSize="12" TextWrapping="Wrap" />
      </Grid>
    </controls:GlassCard>

    <controls:GlassCard Grid.Column="1" CornerRadius="18" TintOpacity="0.30" Padding="16">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <TextBlock Text="Modrinth 搜索" Classes="h2" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Classes="field" Watermark="JEI / Sodium / 机械动力…"
                   Text="{Binding SearchQuery}" />
          <Button Grid.Column="1" Classes="primary" Content="搜索" Command="{Binding SearchCommand}" />
        </Grid>
        <ListBox Grid.Row="2" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchItem}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="2" Margin="2">
                <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" MaxLines="2" />
                <TextBlock Text="{Binding DownloadsText}" Classes="muted" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="3" Classes="primary" Content="安装所选 Mod（需确认）"
                Command="{Binding InstallSelectedCommand}" />
      </Grid>
    </controls:GlassCard>
  </Grid>
</UserControl>
