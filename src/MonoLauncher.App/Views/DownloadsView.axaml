<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MonoLauncher.App.Controls"
             x:Class="MonoLauncher.App.Views.DownloadsView">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <controls:GlassCard Grid.Row="0" CornerRadius="18" TintOpacity="0.30" Padding="20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="下载管理" Classes="h1" FontSize="22" />
          <TextBlock Text="{Binding RecentText}" Classes="muted" />
        </StackPanel>
        <Button Grid.Column="1" Classes="ghost" Content="打开下载缓存目录" Command="{Binding OpenFolderCommand}" />
      </Grid>
    </controls:GlassCard>

    <controls:GlassCard Grid.Row="1" CornerRadius="18" TintOpacity="0.26" Padding="20"
                        IsVisible="{Binding Downloads.IsActive}">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Downloads.Stage}" Foreground="#FFFFFF" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="{Binding Downloads.SpeedText}" Foreground="#8A8A8A" />
        </Grid>
        <ProgressBar Value="{Binding Downloads.Fraction}" Maximum="1" Height="8" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Downloads.BytesText}" Classes="muted" />
          <TextBlock Grid.Column="1" Text="{Binding Downloads.FilesText}" Classes="muted" />
        </Grid>
        <TextBlock Text="{Binding Downloads.Detail}" Classes="muted" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </controls:GlassCard>

    <controls:GlassCard Grid.Row="2" CornerRadius="18" TintOpacity="0.24" Padding="20">
      <StackPanel Spacing="8">
        <TextBlock Text="下载引擎" Classes="h2" />
        <TextBlock Text="有界并发 · HTTP Range 断点续传 · 指数退避重试 · SHA-1/SHA-256 校验 · 临时文件原子提交 · 可取消 · 失败保留定位信息"
                   Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="下载源优先 Mojang 官方；第三方镜像（BMCLAPI）仅在设置中显式开启时作为备用来源。"
                   Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="当前进度来自「游戏下载」与完整性修复任务；同一时刻只有一个安装任务。"
                   Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </controls:GlassCard>
  </Grid>
</UserControl>
