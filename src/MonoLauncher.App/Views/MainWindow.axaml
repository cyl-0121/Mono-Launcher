<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MonoLauncher.App.Controls"
        xmlns:views="using:MonoLauncher.App.Views"
        xmlns:vm="using:MonoLauncher.App.ViewModels"
        x:Class="MonoLauncher.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MonoLauncher"
        Width="1120" Height="700" MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="#000000"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#0A0A0A" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#141414" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2E2E2E" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#0A0A0A" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2E2E2E" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#FFFFFF" />
  </Window.Resources>
  <Window.Styles>
    <!-- SF Pro has a tall ascent, which makes single-line text look pushed up inside
         buttons/labels. Tighten the line box inside buttons only. -->
    <Style Selector="Button TextBlock">
      <Setter Property="LineHeight" Value="17" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8A8A8A" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Top navigation -->
    <Style Selector="Button.nav">
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1FFFFFFF" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Window chrome -->
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#CCCCCC" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22FFFFFF" />
      <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C62828" />
      <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Buttons: inverted (white on black) -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#000000" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E0E0E0" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#BDBDBD" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#3A3A3A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1A1A1A" />
      <Setter Property="BorderBrush" Value="#5A5A5A" />
    </Style>

    <!-- Chat -->
    <Style Selector="Border.msg">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="MaxWidth" Value="720" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="#111111" />
      <Setter Property="BorderBrush" Value="#262626" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.msg.user">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="#1A1A1A" />
      <Setter Property="BorderBrush" Value="#3A3A3A" />
    </Style>
    <Style Selector="Border.msg.tool">
      <Setter Property="Background" Value="#141414" />
      <Setter Property="BorderBrush" Value="#333333" />
    </Style>
    <Style Selector="Border.msg.system">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="#0A0A0A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#2E2E2E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="ComboBox.field">
      <Setter Property="Background" Value="#0A0A0A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#2E2E2E" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="Transparent">
            <Border Name="Bg" Background="#0A0A0A" BorderBrush="#2E2E2E" BorderThickness="1"
                    CornerRadius="6" />
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="10,0,28,0" VerticalAlignment="Center" />
            <TextBlock Text="▾" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,11,0" />
            <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom" VerticalOffset="2"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Background="#0A0A0A" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="6"
                      MaxHeight="280" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
      <Setter Property="Background" Value="#0A0A0A" />
      <Setter Property="BorderBrush" Value="#2E2E2E" />
    </Style>
    <Style Selector="ComboBox /template/ ContentPresenter">
      <Setter Property="Background" Value="#0A0A0A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ComboBox /template/ ToggleButton">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ComboBox /template/ TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ComboBox /template/ Path">
      <Setter Property="Fill" Value="#FFFFFF" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Background" Value="#0A0A0A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1A1A1A" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#1A1A1A" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="48,*">
    <!-- Top bar: brand + navigation, PCL-style -->
    <Grid Grid.Row="0" Name="TitleBar" Background="#000000">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="18,0,0,0"
                    VerticalAlignment="Center">
          <TextBlock Text="MonoLauncher" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" />
          <TextBlock Text="v0.9" FontSize="11" Foreground="#7A7A7A" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
          <!-- Sliding selection pill; positions itself from code, animates through Margin -->
          <Border Name="NavIndicator" Background="#33FFFFFF" CornerRadius="17" Height="34"
                  Width="76" HorizontalAlignment="Left" VerticalAlignment="Center"
                  IsHitTestVisible="False">
            <Border.Transitions>
              <Transitions>
                <ThicknessTransition Property="Margin" Duration="0:0:0.26" Easing="CubicEaseOut" />
                <DoubleTransition Property="Width" Duration="0:0:0.26" Easing="CubicEaseOut" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <StackPanel Name="NavStack" Orientation="Horizontal" Spacing="0">
          <Button Classes="nav" Name="NavHome" Command="{Binding NavigateCommand}" CommandParameter="home">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="▶" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="启动" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavVersions" Command="{Binding NavigateCommand}" CommandParameter="versions">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="⬇" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="下载" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavInstances" Command="{Binding NavigateCommand}" CommandParameter="instances">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="▦" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="版本" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavMods" Command="{Binding NavigateCommand}" CommandParameter="mods">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="◈" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="Mod" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavNetwork" Command="{Binding NavigateCommand}" CommandParameter="network">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="◎" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="联机" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavLogs" Command="{Binding NavigateCommand}" CommandParameter="logs">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="▤" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="日志" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavAgent" Command="{Binding NavigateCommand}" CommandParameter="agent">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="✦" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="AI" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Name="NavSettings" Command="{Binding NavigateCommand}" CommandParameter="settings">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="⚙" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="设置" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Classes="chrome" Content="—" Click="OnMinimizeClick" />
          <Button Classes="chrome" Name="MaxButton" Content="□" Click="OnMaximizeClick" />
          <Button Classes="chrome close" Content="✕" Click="OnCloseClick" />
        </StackPanel>
      </Grid>
      <Border VerticalAlignment="Bottom" Height="1" Background="#1F1F1F" />
    </Grid>

    <!-- Content -->
    <Grid Grid.Row="1" Background="#000000">
      <ContentControl Name="PageHost" Content="{Binding CurrentViewModel}" HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" Margin="16" Background="Transparent">
        <ContentControl.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
            <ThicknessTransition Property="Margin" Duration="0:0:0.22" Easing="CubicEaseOut" />
          </Transitions>
        </ContentControl.Transitions>
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
          </DataTemplate>
          <DataTemplate DataType="vm:AgentViewModel">
            <views:AgentView />
          </DataTemplate>
          <DataTemplate DataType="vm:VersionsViewModel">
            <views:VersionsView />
          </DataTemplate>
          <DataTemplate DataType="vm:InstancesViewModel">
            <views:InstancesView />
          </DataTemplate>
          <DataTemplate DataType="vm:ModsViewModel">
            <views:ModsView />
          </DataTemplate>
          <DataTemplate DataType="vm:NetworkViewModel">
            <views:NetworkView />
          </DataTemplate>
          <DataTemplate DataType="vm:DownloadsViewModel">
            <views:DownloadsView />
          </DataTemplate>
          <DataTemplate DataType="vm:LogsViewModel">
            <views:LogsView />
          </DataTemplate>
          <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>
  </Grid>
</Window>
