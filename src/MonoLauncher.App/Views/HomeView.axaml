<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MonoLauncher.App.Controls"
             x:Class="MonoLauncher.App.Views.HomeView">
  <Grid ColumnDefinitions="360,*" ColumnSpacing="16">

    <!-- Left: launch panel -->
    <Border Grid.Column="0" Background="#0D0D0D" BorderBrush="#262626" BorderThickness="1"
            CornerRadius="10" Padding="22">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
          <Button Content="正版 登录" Command="{Binding LoginMicrosoftCommand}"
                  Background="#121212" Foreground="#FFFFFF" BorderBrush="#3A3A3A" BorderThickness="1"
                  CornerRadius="14" Padding="14,5" FontSize="12" Height="30" />
          <Border Background="#0A0A0A" BorderBrush="#242424" BorderThickness="1" CornerRadius="14"
                  Padding="14,5">
            <TextBlock Text="离线" FontSize="12" Foreground="#8A8A8A" VerticalAlignment="Center" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="14" Margin="0,10,0,0">
          <Border Width="72" Height="72" CornerRadius="36" Background="#1A1A1A" HorizontalAlignment="Center">
            <TextBlock Text="{Binding SelectedAccount.Initial, FallbackValue=?}"
                       FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ComboBox Classes="field" HorizontalAlignment="Stretch" MinHeight="46"
                    ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                    PlaceholderText="选择实例">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Text="{Binding VersionText}" FontSize="10" Foreground="#8A8A8A" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding LaunchHint}" Classes="muted" TextWrapping="Wrap" HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="10">
          <Button Classes="primary" Content="▶  启动游戏" Height="46" FontSize="15"
                  HorizontalAlignment="Stretch" Command="{Binding LaunchCommand}" />

          <Button Classes="ghost" HorizontalAlignment="Stretch" Height="56" Padding="0"
                  VerticalContentAlignment="Center" Command="{Binding GoDownloadCommand}">
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="下载游戏" FontSize="14" HorizontalAlignment="Center" />
              <TextBlock Text="Mojang 官方版本 · 支持 Forge/NeoForge/Fabric"
                         FontSize="10" Foreground="#8A8A8A" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="ghost" Content="版本选择" HorizontalAlignment="Stretch" Height="40"
                  Command="{Binding GoVersionsCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Right: Today / announcement -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBlock Text="Today" FontSize="34" FontWeight="SemiBold" Foreground="#FFFFFF"
                   FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding UpdateStatus}" Classes="muted" VerticalAlignment="Center" />
          <Button Classes="ghost" Content="检查更新" Command="{Binding CheckUpdateCommand}" />
          <Button Classes="primary" Content="查看新版本" IsVisible="{Binding UpdateAvailable}"
                  Command="{Binding OpenUpdateCommand}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="#0D0D0D" BorderBrush="#262626" BorderThickness="1"
              CornerRadius="10" Padding="22">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <TextBlock Grid.Row="0" Text="{Binding AnnouncementTitle}" FontSize="20" FontWeight="SemiBold"
                     Foreground="#FFFFFF" TextWrapping="Wrap" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding AnnouncementDate}" Classes="muted" />
            <TextBlock Text="{Binding UpdateTag}" Classes="muted" />
          </StackPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding AnnouncementBody}" TextWrapping="Wrap" FontSize="13"
                       LineHeight="22" Foreground="#B0B0B0" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
