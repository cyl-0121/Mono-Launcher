<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MonoLauncher.Agent</RootNamespace>
    <AssemblyName>MonoLauncher.Agent</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" />
    <PackageReference Include="LLamaSharp" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
    <!-- Vulkan backend (AMD/Intel/NVIDIA). The launcher picks GPU when available and falls back to CPU. -->
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MonoLauncher.Core\MonoLauncher.Core.csproj" />
  </ItemGroup>
</Project>
